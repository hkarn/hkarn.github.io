{
  "folders": [
    {
      "name": "hkarn.github.io",
      "path": "."
    }
  ],
  "settings": {
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.exclude": {
      "**/node_modules": true,
      "dist": true,
      ".astro": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/package-lock.json": true,
      "**/yarn.lock": true,
      "**/composer.lock": true,
      "api/vendor": true,
      "dist": true,
      ".astro": true
    },
    "typescript.tsdk": "node_modules/typescript/lib"
  },
  "extensions": {
    "recommendations": [
      "astro-build.astro-vscode",
      "ms-azuretools.vscode-docker",
      "bmewburn.vscode-intelephense-client"
    ]
  }
}
