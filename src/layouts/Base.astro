---
import '@fontsource/bodoni-moda/latin-500.css';
import '@fontsource/bodoni-moda/latin-600.css';
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-500.css';
import '../styles/site.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { locales, localeNames, useTranslations, type Locale } from '../i18n/ui';
import { links } from '../data/links';

interface Props {
  lang: Locale;
  /** Path inside the locale, without the locale prefix ('' for the start page). */
  path?: string;
  title?: string;
  description?: string;
  noindex?: boolean;
  home?: boolean;
}
const { lang, path = '', title, description, noindex = false, home = false } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ?? t('meta.title');
const pageDesc = description ?? t('meta.description');
const canonical = getAbsoluteLocaleUrl(lang, path);
const image = new URL(`/og-${lang}.png`, Astro.site).href;
// Structured data for search engines, on the start page only.
const person = home && {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Håkan Kindström Arnoldson',
  alternateName: 'Håkan Arnoldson',
  url: canonical,
  jobTitle: t('meta.jobTitle'),
  address: { '@type': 'PostalAddress', addressLocality: 'Göteborg', addressCountry: 'SE' },
  sameAs: [links.linkedin, links.github],
};
---
<!doctype html>
<html lang={localeNames[lang].htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta name="author" content="Håkan Kindström Arnoldson" />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  {locales.map((l) => (
    <link rel="alternate" hreflang={localeNames[l].htmlLang} href={getAbsoluteLocaleUrl(l, path)} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Håkan Arnoldson" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={localeNames[lang].og} />
  {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={localeNames[l].og} />)}
  <meta property="og:image" content={image} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={t('meta.imageAlt')} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#ff8126" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {person && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
</head>
<body class={home ? 'is-home' : undefined}>
  <a class="skip" href="#main">{t('skip')}</a>
  <slot />
  <script>
    import '../scripts/site.ts';
  </script>
</body>
</html>
